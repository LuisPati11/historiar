{
  "name": "historiar-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "PWA de guía turística AR con gamificación. Cliente WebAR con MindAR + Supabase.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cap:sync": "pnpm build && cap sync",
    "cap:ios": "pnpm cap:sync && cap open ios",
    "cap:android": "pnpm cap:sync && cap open android",
    "gen:qr-bundle": "node node_modules/.pnpm/node_modules/.bin/esbuild node_modules/qrcode/lib/index.js --bundle --platform=browser --global-name=QRCode --outfile=public/qrcode.bundle.js --minify"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "2.114.0",
    "i18next": "^23.15.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "maplibre-gl": "^6.7.0",
    "mind-ar": "1.2.5",
    "node-fetch": "2.7.0",
    "qr-scanner": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.0",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "^7.18.3",
    "three": "0.157.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.157.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "26.1.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
