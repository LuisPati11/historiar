{
  "name": "historiar-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "PWA de guía turística AR con gamificación. Cliente WebAR con MindAR + Supabase.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cap:sync": "pnpm build && cap sync",
    "cap:ios": "pnpm cap:sync && cap open ios",
    "cap:android": "pnpm cap:sync && cap open android",
    "gen:qr-bundle": "node node_modules/.pnpm/node_modules/.bin/esbuild node_modules/qrcode/lib/index.js --bundle --platform=browser --global-name=QRCode --outfile=public/qrcode.bundle.js --minify"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.2.0",
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@react-leaflet/core": "2",
    "@supabase/supabase-js": "^2.45.0",
    "i18next": "^23.15.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "mind-ar": "^1.2.5",
    "qr-scanner": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.0",
    "react-leaflet": "^4.2.1",
    "react-map-gl": "^8.1.1",
    "react-router-dom": "^6.26.0",
    "three": "0.157.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.157.0",
    "@vitejs/plugin-react": "^4.3.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0"
  }
}
