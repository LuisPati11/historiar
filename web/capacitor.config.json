{
  "appId": "app.historiar",
  "appName": "HistoriAR",
  "webDir": "dist",
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#1a1a1a"
    }
  }
}
